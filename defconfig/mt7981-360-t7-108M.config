# ============================================================
# 360T7 (MT7981) - 108M 扩容分区 · 干净基础路由版 种子配置
# 目标菜单（对齐用户当前固件的 LuCI 界面）：
#   状态页：概览 / 防火墙 / 路由表 / 系统日志 / 系统进程 / 实时信息
#   网络页：接口 / 无线 / 交换机 / DHCP-DNS / 主机名 / IP-MAC绑定 /
#           静态路由 / 防火墙 / 网络诊断 / 网络加速
# 不要：代理、USB外设、文件共享、流量控制(eqos)、流量检测(netdata等)、杂项插件。
# 说明：
#   - 本文件配合 GitHub Actions 无交互编译，由 `make defconfig` 展开成完整 .config。
#   - 108M 布局要求已刷【修改版 U-Boot】（原厂 uboot 起不来，勿混用 36M）。
#   - WiFi(MTK 闭源驱动) 由镜像默认携带，无需在此操作。
# ============================================================

# ---------- 1. 目标平台：Mediatek Filogic (MT7981)，仅 360T7-108M 一台 ----------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7981=y
# 设备符号：必须用 CONFIG_TARGET_DEVICE_<target>_<subtarget>_DEVICE_<设备profile名>
# 注意：设备名是 qihoo-360-t7-108M（mt7981-360-t7-108M 只是它的 DTS 名，不是 profile 名）
CONFIG_TARGET_DEVICE_mediatek_mt7981_DEVICE_qihoo-360-t7-108M=y
# 单设备模式（避免把 mt7981 全部 52 台都编译）
CONFIG_TARGET_MULTI_PROFILE=n

# ---------- 2. 需要保留：基础路由 + 中文 LuCI + 网络加速 ----------
# LuCI Web 管理界面（meta 包）：自带 状态页全部 + 网络页的接口/无线/交换机/
#   DHCP-DNS/主机名/IP-MAC/静态路由/防火墙/网络诊断（即截图里的绝大多数菜单）
CONFIG_PACKAGE_luci=y
# 防火墙管理界面 + 中文
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
# PPPoE 拨号（ppp + 内核模块 + LuCI 协议）
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-pppoe=y
# IPv6
# 注意：不要手动启用完整版 odhcpd！ImmortalWrt 默认自带 odhcpd-ipv6only，
# 它已提供 RA 路由器通告 + DHCPv6 + 前缀下发（即你要的 IPv6 功能），
# 且 ipv6helper 会强制把它拉回来。若再加 odhcpd=y 会与 odhcpd-ipv6only
# 安装同一批文件(/usr/sbin/odhcpd 等) → package/install 报文件冲突 Error 255。
# 这里只用默认 odhcpd-ipv6only + DHCPv6 客户端即可。
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_kmod-ip6tables=y
# 网络加速（MTK HNAT，对应截图里的"网络加速"菜单；非流量检测）
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# WiFi（必须显式启用！）：
# kmod-mt_wifi = MTK 闭源 WiFi AP 驱动。它不是 mt7981 默认包（参考板编译已验证无 WiFi），
# 必须加这一行。其依赖会自动带上 kmod-mediatek_hnat(硬件加速 PPE/HNAT) + kmod-warp(WiFi 加速代理)
# + kmod-conninfra + wifi-dats → WiFi 驱动与无线硬件加速一次到位。
# LuCI 的「网络→无线」页面即可配置。
CONFIG_PACKAGE_kmod-mt_wifi=y
# Argon 主题（可选主题，装上后可在 LuCI 系统→系统→主题里切换；默认仍为 bootstrap）
CONFIG_PACKAGE_luci-theme-argon=y
# 基础工具
CONFIG_PACKAGE_kmod-mii=y
CONFIG_PACKAGE_kmod-ppp=y

# ---------- 3. 明确【不要】的插件（=n 覆盖默认选中） ----------
# 流量控制 / 智能调速（MTK eqos）—— 用户明确不要
CONFIG_PACKAGE_luci-app-eqos-mtk=n
CONFIG_PACKAGE_eqos=n
# 流量检测 / 监控类 —— 用户明确不要（网络加速 turboacc 保留，这里只关监控类）
CONFIG_PACKAGE_netdata=n
CONFIG_PACKAGE_luci-app-statistics=n
CONFIG_PACKAGE_luci-app-wrtbwmon=n
CONFIG_PACKAGE_mtkhnat_util=n
# USB 外设 / 存储挂载 / 文件共享（360T7 无 USB 口，全部关掉）
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb2=n
CONFIG_PACKAGE_kmod-usb3=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_usbutils=n
CONFIG_PACKAGE_automount=n
CONFIG_PACKAGE_block-mount=n
CONFIG_PACKAGE_samba36-server=n
CONFIG_PACKAGE_luci-app-samba=n
# 代理类插件（确保不出现）
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_luci-app-ssr-plus=n

# ============================================================
# 提示：若某个包名在该仓库中不存在，defconfig 会自动忽略该行（不会报错）。
# 基础三件套（luci / ppp / 防火墙 / odhcp）是标准 OpenWrt 包名，必定生效。
# ============================================================
